# Use Railway's public URL on your laptop.
# postgres.railway.internal only works from a service deployed on Railway.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# Used to draw and film the job on /live/[token].
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

IMESSAGE_API_URL=https://imessage.velroi.com
IMESSAGE_API_KEY=
IMESSAGE_WEBHOOK_SECRET=
# Only set true when users have real opted-in phone numbers.
IMESSAGE_LIVE=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

DEMO_MODE=true
# Worker invitations stay dry-run unless this is true. The personal agent sends live job SMS.
CRON_SECRET=

# Daphne's ethics app (gotchu). Market-maker is :3000, so run gotchu on 3001.
ETHICS_BASE_URL=http://127.0.0.1:3001

# Public origin for /live/[token] links texted to requesters.
MARKET_MAKER_PUBLIC_URL=http://localhost:3000

# Optional: pull already-made clips from voice-mcp for a real order.
VOICE_MCP_URL=http://127.0.0.1:3010

# MinIO / S3-compatible bucket for live pictures and clips.
S3_ENDPOINT=https://minio-production-c0d2.up.railway.app
S3_BUCKET=gotchu-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
