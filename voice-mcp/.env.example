DATABASE_URL=postgres://user:pass@localhost:5432/gotchu
PORT=3010
MCP_AUTH_TOKEN=

# Devnet wallets: everyone the agent talks to gets one, funded from a
# treasury you fund yourself. This is all free devnet SOL, never real money.
# Users see "railcoins": 50,000 railcoins = 1 SOL, so a 50-railcoin starting
# balance is 0.001 SOL - as low as Solana's rent-exempt minimum for a new
# account allows, since the devnet faucet only gives the treasury 5 SOL
# every 8 hours.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_AIRDROP_SOL=0.001

# Run `npm run create-treasury` to generate these two, then
# `solana airdrop 5 <printed public key> --url devnet` to fund it.
SOLANA_TREASURY_SECRET_KEY=

# Any random 32+ char string. Wallet secret keys are encrypted at rest with it.
WALLET_ENCRYPTION_KEY=
