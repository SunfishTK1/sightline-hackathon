# Separate M2M application authorized for the Auth0 Management API
# (Applications > Gotchu CMU (M2M) > APIs > Auth0 Management API, with
# read:users, create:users, update:users scopes). Used to create the
# unverified database-connection user on onboarding submit and to send
# Auth0's own verification email.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication
DATABASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ENABLE_SOLANA=false
NEXT_PUBLIC_ENABLE_VOICE=false
